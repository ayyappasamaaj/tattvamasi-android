<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Firebase, the website's pages, the board and the PDFs -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Notifications from the website (Android 13+ asks; the app asks the first time an event is opened) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The Namavali player keeps chanting with the screen off or in another app (ui/yatra/NamavaliService.kt) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tattvamasi">
        <!-- Google Pay in Stripe's payment sheet (ui/donate) -->
        <meta-data android:name="com.google.android.gms.wallet.api.enabled" android:value="true" />
        <!-- One activity for the whole app (Compose); the splash theme shows the icon while it starts -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Tattvamasi.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The Namavali player: plays in the background, with the lock screen's and earphones' controls. Exported
             so the system's media controls (and Bluetooth, Android Auto) can reach the media session, as Media3 asks -->
        <service
            android:name=".ui.yatra.NamavaliService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
        <!-- The tanpura (shruti) player, the same way (ui/shruti/ShrutiPlayer.kt) -->
        <service
            android:name=".ui.shruti.ShrutiService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Notifications that arrive while the app is open (notifications/AppMessagingService.kt) -->
        <service
            android:name=".notifications.AppMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- For notifications the system shows while the app is in the background -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="announcements" />
    </application>

</manifest>
