<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- The redesigned app (Compose). The splash screen shows the website header's medallion on the website's cream
         (its dark page in the phone's dark mode), with the name and tagline under it from Android 12 on
         (values-v31), then the app's own theme takes over. -->
    <style name="Theme.Tattvamasi" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/cream</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- The app draws its own dark mode (ui/theme: the website's dark colors, Appearance), so the system never
             darkens it on its own ("force dark" / expanded dark theme). values-night/colors.xml darkens the window. -->
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
    </style>

    <style name="Theme.Tattvamasi.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/cream</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Tattvamasi</item>
    </style>
</resources>
