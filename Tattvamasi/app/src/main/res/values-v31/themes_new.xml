<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and later: as values/themes_new.xml, with the website header's name and tagline band under the
         medallion (drawable-nodpi/splash_branding: maroon name; drawable-night-nodpi: gold, for the dark page). -->
    <style name="Theme.Tattvamasi.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/cream</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/splash_branding</item>
        <item name="postSplashScreenTheme">@style/Theme.Tattvamasi</item>
    </style>
</resources>
